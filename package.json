{
  "name": "hannah-nails",
  "private": true,
  "version": "0.0.1",
  "main": "dist-electron/main/main.js",
  "description": "Ứng dụng quản lý tiệm nail Hannah",
  "author": "Hannah Nails Team",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "electron:prebuild": "tsc -p tsconfig.node.json",
    "electron:dev": "npm run electron:prebuild && cross-env NODE_ENV=development vite --mode=development",
    "clean": "rimraf dist dist-electron release",
    "electron:build": "npm run clean && vue-tsc -b && vite build && electron-builder",
    "electron:preview": "electron-builder --dir"
  },
  "dependencies": {
    "@alova/mock": "^2.0.14",
    "@iconify/vue": "^5.0.0",
    "@types/node": "^22.15.18",
    "@vicons/antd": "^0.13.0",
    "@vicons/ionicons5": "^0.13.0",
    "@vueuse/core": "^10.11.1",
    "alova": "^3.2.10",
    "axios": "^1.9.0",
    "echarts": "^5.6.0",
    "less": "^4.3.0",
    "naive-ui": "^2.41.0",
    "pinia": "^3.0.2",
    "pinia-plugin-persistedstate": "^4.2.0",
    "radash": "^12.1.0",
    "typeit": "^8.8.7",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1",
    "vue-types": "^6.0.0",
    "vuedraggable": "^2.24.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/tsconfig": "^0.7.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "electron": "^36.2.0",
    "electron-builder": "^26.0.12",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vue-tsc": "^2.2.8",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.hannahnails.app",
    "productName": "Hannah Nails",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
